local function PlaySound(soundId, volume)
    task.spawn(function()
        pcall(function()
            local snd = Instance.new("Sound")
            snd.SoundId = soundId
            snd.Volume = volume or 0.35
            snd.Parent = SoundService
            snd:Play()
