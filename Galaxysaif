function ZenithUI.CreateDropdown(container, labelText, options, defaultOption, callback)
    local selected = defaultOption or options[1]
    local isOpen = false

    local dropdownBox = Instance.new("Frame")
    dropdownBox.Size = UDim2.new(1, 0, 0, 44)
    dropdownBox.BackgroundColor3 = Color3.fromRGB(22, 26, 38)
    dropdownBox.BackgroundTransparency = 0.4
    dropdownBox.BorderSizePixel = 0
    dropdownBox.ClipsDescendants = true
    dropdownBox.Parent = container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = dropdownBox

    local stroke = Instance.new("UIStroke")
    stroke.Color = THEME.CardStroke
    stroke.Transparency = 0.6
    stroke.Thickness = 1
    stroke.Parent = dropdownBox

    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 44)
    header.BackgroundTransparency = 1
    header.Parent = dropdownBox

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.45, 0, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Text = labelText
    label.TextColor3 = THEME.TextPrimary
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Parent = header

    local currentVal = Instance.new("TextLabel")
    currentVal.Size = UDim2.new(0.55, -46, 1, 0)
    currentVal.Position = UDim2.new(0.45, 0, 0, 0)
    currentVal.Text = selected
    currentVal.TextColor3 = THEME.NeonCyan
    currentVal.TextSize = 12
    currentVal.Font = Enum.Font.GothamSemibold
    currentVal.TextXAlignment = Enum.TextXAlignment.Right
    currentVal.BackgroundTransparency = 1
    currentVal.Parent = header

    local arrowHolder = Instance.new("Frame")
    arrowHolder.Name = "ArrowHolder"
    arrowHolder.Size = UDim2.new(0, 16, 0, 16)
    arrowHolder.Position = UDim2.new(1, -22, 0.5, 0)
    arrowHolder.AnchorPoint = Vector2.new(0.5, 0.5)
    arrowHolder.BackgroundTransparency = 1
    arrowHolder.Parent = header

    local leftLeg = Instance.new("Frame")
    leftLeg.Size = UDim2.new(0, 6, 0, 2)
    leftLeg.Position = UDim2.new(0.5, -2, 0.5, 0)
    leftLeg.AnchorPoint = Vector2.new(0.5, 0.5)
    leftLeg.Rotation = 45
    leftLeg.BackgroundColor3 = THEME.NeonCyan
    leftLeg.BorderSizePixel = 0
    leftLeg.Parent = arrowHolder

    local leftCorner = Instance.new("UICorner")
    leftCorner.CornerRadius = UDim.new(1, 0)
    leftCorner.Parent = leftLeg

    local rightLeg = Instance.new("Frame")
    rightLeg.Size = UDim2.new(0, 6, 0, 2)
    rightLeg.Position = UDim2.new(0.5, 2, 0.5, 0)
    rightLeg.AnchorPoint = Vector2.new(0.5, 0.5)
    rightLeg.Rotation = -45
    rightLeg.BackgroundColor3 = THEME.NeonCyan
    rightLeg.BorderSizePixel = 0
    rightLeg.Parent = arrowHolder

    local rightCorner = Instance.new("UICorner")
    rightCorner.CornerRadius = UDim.new(1, 0)
    rightCorner.Parent = rightLeg

    local trigger = Instance.new("TextButton")
    trigger.Size = UDim2.new(1, 0, 1, 0)
    trigger.BackgroundTransparency = 1
    trigger.Text = ""
    trigger.ZIndex = 2
    trigger.Parent = header

    trigger.MouseEnter:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = THEME.NeonCyan, Transparency = 0.4}):Play()
        TweenService:Create(leftLeg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        TweenService:Create(rightLeg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end)

    trigger.MouseLeave:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = THEME.CardStroke, Transparency = 0.6}):Play()
        TweenService:Create(leftLeg, TweenInfo.new(0.15), {BackgroundColor3 = THEME.NeonCyan}):Play()
        TweenService:Create(rightLeg, TweenInfo.new(0.15), {BackgroundColor3 = THEME.NeonCyan}):Play()
    end)

    local optScroll = Instance.new("ScrollingFrame")
    optScroll.Size = UDim2.new(1, -24, 0, math.min(#options * 32, 130))
    optScroll.Position = UDim2.new(0, 12, 0, 48)
    optScroll.BackgroundTransparency = 1
    optScroll.BorderSizePixel = 0
    optScroll.ScrollBarThickness = 3
    optScroll.ScrollBarImageColor3 = THEME.NeonCyan
    optScroll.ScrollBarImageTransparency = 0.4
    optScroll.CanvasSize = UDim2.new(0, 0, 0, #options * 32)
    optScroll.Parent = dropdownBox

    local optLayout = Instance.new("UIListLayout")
    optLayout.Padding = UDim.new(0, 4)
    optLayout.Parent = optScroll

    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 28)
        optBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 50)
        optBtn.BackgroundTransparency = 0.4
        optBtn.Text = " " .. opt
        optBtn.TextColor3 = (opt == selected) and THEME.NeonCyan or THEME.TextSecondary
        optBtn.TextSize = 12
        optBtn.Font = Enum.Font.Gotham
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.AutoButtonColor = false
        optBtn.Parent = optScroll

        local optCorner = Instance.new("UICorner")
        optCorner.CornerRadius = UDim.new(0, 6)
        optCorner.Parent = optBtn

        optBtn.MouseEnter:Connect(function()
            TweenService:Create(optBtn, TweenInfo.new(0.12), {TextColor3 = THEME.NeonCyan, BackgroundTransparency = 0.15}):Play()
        end)
        optBtn.MouseLeave:Connect(function()
            local col = (opt == selected) and THEME.NeonCyan or THEME.TextSecondary
            TweenService:Create(optBtn, TweenInfo.new(0.12), {TextColor3 = col, BackgroundTransparency = 0.4}):Play()
        end)

        optBtn.MouseButton1Click:Connect(function()
            PlaySound(SOUNDS.Click, 0.3)
            selected = opt
            currentVal.Text = selected
            isOpen = false
            TweenService:Create(dropdownBox, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, 44)}):Play()
            TweenService:Create(arrowHolder, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {Rotation = 0}):Play()
            if callback then callback(selected) end
        end)
    end

    trigger.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        PlaySound(SOUNDS.Click, 0.25)
        local targetH = isOpen and (54 + math.min(#options * 32, 130)) or 44
        TweenService:Create(dropdownBox, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, targetH)
        }):Play()
        TweenService:Create(arrowHolder, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Rotation = isOpen and 180 or 0
        }):Play()
    end)
end

function ZenithUI.CreateTextInput(container, labelText, placeholder, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 44)
    frame.BackgroundColor3 = Color3.fromRGB(22, 26, 38)
    frame.BackgroundTransparency = 0.4
    frame.BorderSizePixel = 0
    frame.Parent = container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = THEME.CardStroke
    stroke.Transparency = 0.6
    stroke.Thickness = 1
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Text = labelText
    label.TextColor3 = THEME.TextPrimary
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.6, -24, 0, 28)
    box.Position = UDim2.new(0.4, 10, 0.5, -14)
    box.BackgroundColor3 = Color3.fromRGB(15, 18, 27)
    box.BackgroundTransparency = 0.3
    box.TextColor3 = THEME.TextPrimary
    box.PlaceholderColor3 = THEME.TextMuted
    box.PlaceholderText = placeholder or "Type here..."
    box.Text = ""
    box.TextSize = 12
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.Parent = frame

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = box

    box.Focused:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = THEME.NeonCyan, Transparency = 0.3}):Play()
    end)
    box.FocusLost:Connect(function(enterPressed)
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = THEME.CardStroke, Transparency = 0.6}):Play()
        if callback then callback(box.Text, enterPressed) end
    end)
end

