local function Notify(titleText, descText, duration, notifType)
    duration = duration or 3.5
    notifType = notifType or "Info"
    PlaySound(SOUNDS.Notif, 0.4)
    local typeColors = {
        Success = THEME.Success,
        Warning = THEME.Warning,
        Danger = THEME.Danger,
        Info = THEME.NeonCyan,
    }
    local accentColor = typeColors[notifType] or THEME.NeonCyan

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 68)
    card.Position = UDim2.new(1, 100, 0, 0)
    card.BackgroundColor3 = THEME.WindowGlass
    card.BackgroundTransparency = 0.12
    card.ClipsDescendants = true
    card.Parent = notifContainer

    local cardCorner = Instance.new("UICorner")
    cardCorner.CornerRadius = UDim.new(0, 10)
    cardCorner.Parent = card

    local cardStroke = Instance.new("UIStroke")
    cardStroke.Color = accentColor
    cardStroke.Transparency = 0.45
    cardStroke.Thickness = 1.4
    cardStroke.Parent = card

    local glowBar = Instance.new("Frame")
    glowBar.Size = UDim2.new(0, 4, 1, 0)
    glowBar.BackgroundColor3 = accentColor
    glowBar.BorderSizePixel = 0
    glowBar.Parent = card

    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -26, 0, 22)
    tLabel.Position = UDim2.new(0, 16, 0, 10)
    tLabel.BackgroundTransparency = 1
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextSize = 13
    tLabel.TextColor3 = accentColor
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Text = titleText
    tLabel.Parent = card

    local dLabel = Instance.new("TextLabel")
    dLabel.Size = UDim2.new(1, -26, 0, 26)
    dLabel.Position = UDim2.new(0, 16, 0, 32)
    dLabel.BackgroundTransparency = 1
    dLabel.Font = Enum.Font.Gotham
    dLabel.TextSize = 12
    dLabel.TextColor3 = THEME.TextSecondary
    dLabel.TextXAlignment = Enum.TextXAlignment.Left
    dLabel.TextWrapped = true
    dLabel.Text = descText
    dLabel.Parent = card

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, 3)
    bar.Position = UDim2.new(0, 0, 1, -3)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel = 0
    bar.Parent = card

    card.Position = UDim2.new(1, 80, 0, 0)
    TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
    TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 3)}):Play()

    local hitDismiss = Instance.new("TextButton")
    hitDismiss.Size = UDim2.new(1, 0, 1, 0)
    hitDismiss.BackgroundTransparency = 1
    hitDismiss.Text = ""
    hitDismiss.Parent = card

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        local out = TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 100, 0, 0),
            BackgroundTransparency = 1
        })
        out:Play()
        out.Completed:Connect(function()
            card:Destroy()
        end)
    end

    hitDismiss.MouseButton1Click:Connect(dismiss)
    task.delay(duration, dismiss)
end

