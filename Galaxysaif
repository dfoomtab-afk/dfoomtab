    kbStroke.Color = THEME.NeonCyan
    kbStroke.Transparency = 0.7
    kbStroke.Thickness = 1
    kbStroke.Parent = keyBtn

    keyBtn.MouseButton1Click:Connect(function()
        binding = true
        keyBtn.Text = "..."
        kbStroke.Color = THEME.Warning
