local function PatchTraps()
    local trapNames = { "MeteorTrap", "Tsunami1" , "G2W1_NPC1", "LavaTower" }
    task.spawn(function()
        while task.wait(0.5) do
            local traps = game:GetService("Workspace"):FindFirstChild("Traps")
            if traps then
                for _, name in ipairs(trapNames) do
                    local trap = traps:FindFirstChild(name)
                    if trap then
                        pcall(function()
                            trap:Destroy()
                        end)
                    end
                end
            end
        end
    end)
end

