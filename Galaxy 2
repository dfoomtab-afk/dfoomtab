-- 8. تحديث لغات الواجهة
-- ==========================================
function updateLanguageText()
    local t = translations[currentLang] or translations.ar
    titleLabel.Text = t.title
    
    speedInput.PlaceholderText = t.walkSpeed .. " (حالياً: " .. MOVE_SPEED .. ")"
    speedInput.Text = tostring(MOVE_SPEED)

    opacityInput.PlaceholderText = t.opacity .. " (0 - 1)"
    
    pathBtn.Text = isPathRunning and t.stopWalk or t.startWalk
    pathBtn.BackgroundColor3 = isPathRunning and Color3.fromRGB(180, 40, 40) or Color3.fromRGB(40, 140, 60)
    
    noclipBtn.Text = isNoclipEnabled and t.noclipOn or t.noclipOff
    noclipBtn.BackgroundColor3 = isNoclipEnabled and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(40, 40, 40)

    jumpFlyBtn.Text = isJumpFlyEnabled and t.jumpFlyOn or t.jumpFlyOff
    jumpFlyBtn.BackgroundColor3 = isJumpFlyEnabled and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(40, 40, 40)
end

