-- الحلقة الرئيسية
local mainConnection = RunService.RenderStepped:Connect(function(deltaTime)
    frameCount = frameCount + 1
    local currentTime = os.clock()
    if currentTime - lastTime >= 1.0 then
        currentFPS = math.floor(frameCount / (currentTime - lastTime))
        fpsText.Text = "معدل الإطارات (FPS): " .. tostring(currentFPS)
        
        if currentFPS >= 50 then
            fpsText.TextColor3 = Color3.fromRGB(80, 220, 120)
        elseif currentFPS >= 30 then
            fpsText.TextColor3 = Color3.fromRGB(240, 180, 50)
        else
            fpsText.TextColor3 = Color3.fromRGB(230, 60, 60)
        end
        
        local rawPing = 60
        pcall(function()
            rawPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        
        pingText.Text = "قوة الاتصال (Ping): " .. tostring(rawPing) .. " ms"
        if rawPing <= 80 then
            pingText.TextColor3 = Color3.fromRGB(80, 220, 120)
        elseif rawPing <= 160 then
            pingText.TextColor3 = Color3.fromRGB(240, 180, 50)
        else
            pingText.TextColor3 = Color3.fromRGB(230, 60, 60)
        end

        updatePlayersList(rawPing)

        frameCount = 0
        lastTime = currentTime
    end

    if isScriptPaused then return end

    local char = player.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if humanoid and isSpeedEnabled then
        humanoid.WalkSpeed = currentSpeed
    end

    if (activeTween or isAutoWalking) and hrp and not isFlyEnabled then
        local currentPos = hrp.Position
        if math.abs(currentPos.Y - FIXED_Y) > 0.1 then
            hrp.CFrame = CFrame.new(currentPos.X, FIXED_Y, currentPos.Z) * (hrp.CFrame - hrp.CFrame.Position)
        end
    end

    if isFlyEnabled and hrp then
        if isJumpingPressed() then
            if not flyVelocity or flyVelocity.Parent ~= hrp then
                flyVelocity = Instance.new("BodyVelocity")
                flyVelocity.MaxForce = Vector3.new(0, 1e7, 0)
                flyVelocity.Velocity = Vector3.new(0, 70, 0)
                flyVelocity.Parent = hrp
            end
        else
            if flyVelocity then
                flyVelocity:Destroy()
                flyVelocity = nil
            end
        end
    else
        if flyVelocity then
            flyVelocity:Destroy()
            flyVelocity = nil
        end
    end

    if isNoclipEnabled and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

