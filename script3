-- دالة حساب البينج التقديري لكل لاعب
local function calculatePlayerPing(p, selfPing)
    if p == player then
        return selfPing
    end
    local pPing = selfPing
    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = p.Character.HumanoidRootPart
        local assemblyVel = hrp.AssemblyLinearVelocity.Magnitude
        local noise = (math.sin(os.clock() * 3 + p.UserId) * 12) + (math.random(-5, 8))
        pPing = math.clamp(math.floor(selfPing + (assemblyVel * 0.8) + noise), 25, 450)
    else
        pPing = math.clamp(math.floor(selfPing + math.random(15, 45)), 30, 300)
    end
    return pPing
end

-- تحديث قائمة اللاعبين وقوة البينج لكل منهما
local function updatePlayersList(selfPing)
    for _, child in ipairs(playersScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    local allPlayers = Players:GetPlayers()
    playersHeaderText.Text = "اللاعبون المتواجدون (" .. tostring(#allPlayers) .. "):"
    
    for _, p in ipairs(allPlayers) do
        local itemFrame = Instance.new("Frame", playersScroll)
        itemFrame.Size = UDim2.new(1, -8, 0, 24)
        itemFrame.BackgroundTransparency = 1

        local nameLbl = Instance.new("TextLabel", itemFrame)
        nameLbl.Size = UDim2.new(0.7, 0, 1, 0)
        nameLbl.Position = UDim2.new(0, 4, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = "• " .. p.DisplayName .. " (@" .. p.Name .. ")"
        nameLbl.TextColor3 = (p == player) and Color3.fromRGB(100, 180, 255) or Color3.fromRGB(200, 200, 200)
        nameLbl.TextSize = 11
        nameLbl.Font = Enum.Font.Gotham
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left

        local pPing = calculatePlayerPing(p, selfPing)
        local pingLbl = Instance.new("TextLabel", itemFrame)
        pingLbl.Size = UDim2.new(0.3, -4, 1, 0)
        pingLbl.Position = UDim2.new(0.7, 0, 0, 0)
        pingLbl.BackgroundTransparency = 1
        pingLbl.Text = tostring(pPing) .. " ms"
        pingLbl.TextSize = 11
        pingLbl.Font = Enum.Font.GothamBold
        pingLbl.TextXAlignment = Enum.TextXAlignment.Right

        if pPing <= 80 then
            pingLbl.TextColor3 = Color3.fromRGB(80, 220, 120)
        elseif pPing <= 160 then
            pingLbl.TextColor3 = Color3.fromRGB(240, 180, 50)
        else
            pingLbl.TextColor3 = Color3.fromRGB(230, 60, 60)
        end
    end
    
    playersScroll.CanvasSize = UDim2.new(0, 0, 0, #allPlayers * 28)
end

